{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/audio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/audio/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bmw/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/bmw",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/toyota/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/toyota",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/mercedes/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/mercedes",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/nissan/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/nissan",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/honda/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/honda",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ford/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ford",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hyundai/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hyundai",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/kia/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/kia",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lexus/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lexus",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/land-rover/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/land-rover",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/seo_pages/:path*",
      "destination": "/audio",
      "permanent": false
    },
    {
      "source": "/seo_pages_us/:path*",
      "destination": "/audio",
      "permanent": false
    },
    {
      "source": "/cost-calculator",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/cost-calculator/:path*",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/vision",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/research",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/research/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/repairs/:path*",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/sound-meter",
      "destination": "/audio",
      "permanent": false
    },
    {
      "source": "/engine-ticking-noise",
      "destination": "/audio",
      "permanent": false
    },
    {
      "source": "/engine-ticking-noise/:path*",
      "destination": "/audio",
      "permanent": false
    },
    {
      "source": "/over-bumps-:path*",
      "destination": "/audio",
      "permanent": false
    },
    {
      "source": "/car-noise-identifier(.*)",
      "destination": "/audio",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Bytespider|PetalBot|Baiduspider|Sogou|YisouSpider|SemrushBot|AhrefsBot|DotBot).*"
        }
      ],
      "destination": "https://carithm.vercel.app/404",
      "statusCode": 403
    }
  ],
  "rewrites": [
    {
      "source": "/audio",
      "destination": "/audio/src/cardiag/web/static/app"
    },
    {
      "source": "/audio/",
      "destination": "/audio/src/cardiag/web/static/app"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/404.html"
    }
  ]
}