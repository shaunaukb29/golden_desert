{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/audio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/audio/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/car-noise-identifier(.*)",
      "destination": "/audio",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Bytespider|PetalBot|Baiduspider|Sogou|YisouSpider|SemrushBot|AhrefsBot|DotBot).*"
        }
      ],
      "destination": "https://carithm.vercel.app/404",
      "statusCode": 403
    }
  ],
  "rewrites": [
    {
      "source": "/audio",
      "destination": "/audio/src/cardiag/web/static/app"
    },
    {
      "source": "/audio/",
      "destination": "/audio/src/cardiag/web/static/app"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/404.html"
    }
  ]
}
